{
  "name": "figma-ant-design-admin-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "share": "npm run build && node scripts/inline-share.mjs",
    "review:members": "npm run build && node scripts/inline-share.mjs --review=members",
    "review:all": "npm run build && node scripts/inline-share.mjs --review=all",
    "prd:all": "npm run build && node scripts/inline-share.mjs --prd=all",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
